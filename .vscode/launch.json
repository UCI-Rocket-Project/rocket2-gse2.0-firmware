{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Google Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/TestNative/tests/scheduler_tests",
            "args": [
                "--gtest_color=yes"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}